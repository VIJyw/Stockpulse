# Copy to .env (never commit .env). Leave DATABASE_URL unset to use a local SQLite file.
# Neon/Supabase connection string, e.g.:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
# Optional: Slack or Discord incoming-webhook URL for failure alerts
ALERT_WEBHOOK_URL=
# Used by scripts/smoke_test.py
API_BASE_URL=http://localhost:5000
